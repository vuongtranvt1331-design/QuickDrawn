<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>QUICK DRAWN — LexicalSpace Western Vocabulary Duel</title>
  <!-- Google Fonts for Retro Pixel & Western Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Chakra+Petch:wght@600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-outer: #2b1810;
      --card-cream: #f8edd6;
      --card-border-orange: #ee821a;
      --wood-dark: #4f2711;
      --wood-mid: #7d4218;
      --wood-light: #9e5824;
      --word-blue-bg: #99ccff;
      --word-blue-border: #0e63c6;
      --word-blue-highlight: #bbe0ff;
      --word-navy-text: #112277;
      --meaning-blue-text: #3863a8;
      --btn-gold-bg: #fae078;
      --btn-gold-border: #c56212;
      --btn-gold-shadow: #9b4508;
      --btn-gold-highlight: #fff3b8;
      --btn-text-dark: #381808;
      --danger-red: #d32f2f;
      --success-green: #2e7d32;
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      height: 100dvh;
      overflow: hidden;
      background: radial-gradient(circle at center, #3d2214 0%, #1c0f08 100%);
      font-family: 'Chakra Petch', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--btn-text-dark);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Main Mobile-First Portrait Frame */
    .game-shell {
      position: relative;
      width: 100%;
      max-width: 430px;
      height: 100%;
      height: 100dvh;
      max-height: 880px;
      padding: calc(8px + var(--safe-top)) 10px calc(8px + var(--safe-bottom)) 10px;
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 460px) {
      .game-shell {
        height: 96dvh;
        max-height: 880px;
        padding: 10px;
      }
    }

    @media (max-height: 740px) {
      .duel-stage {
        max-height: 125px;
      }
      .desert-footer {
        height: 38px;
      }
      .answer-btn {
        height: 52px;
        min-height: 52px;
        padding: 4px 8px;
        font-size: 0.95rem;
      }
      .answers-grid {
        gap: 8px 10px;
        padding: 4px 14px;
      }
      .main-playable-area {
        margin-top: 4px;
      }
    }

    .arcade-card {
      position: relative;
      width: 100%;
      height: 100%;
      background-color: var(--card-cream);
      border: 5px solid var(--card-border-orange);
      border-radius: 26px;
      box-shadow:
        0 14px 36px rgba(0, 0, 0, 0.65),
        inset 0 0 0 3px #fdf6e9;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    /* =========================================================================
       TOP NAVIGATION BAR & REPOSITIONED TIMER
       Minimised clutter, unified button dimensions, dedicated prominent timer
       ========================================================================= */
    .top-hud {
      position: relative;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px 4px 14px;
      gap: 10px;
      flex-shrink: 0;
      width: 100%;
    }

    /* Category 1: Header / Navigation Controls (Exit, Sound Toggle, etc.) */
    .header-btn {
      width: 40px;
      min-width: 40px;
      height: 40px;
      min-height: 40px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      font-family: 'Chakra Petch', sans-serif;
      box-sizing: border-box;
      cursor: pointer;
      user-select: none;
      touch-action: manipulation;
      transition: transform 0.08s ease, filter 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
      text-decoration: none;
    }

    .header-btn:active:not(:disabled) {
      transform: translateY(2px);
    }

    /* Compact Exit Icon Button */
    .header-btn.exit-btn {
      color: #fae078;
      background: linear-gradient(180deg, #5c2419 0%, #35140d 100%);
      border: 2.5px solid #8c3b1e;
      box-shadow:
        inset 0 2px 0 rgba(255, 180, 140, 0.3),
        inset 0 -2px 0 rgba(0, 0, 0, 0.4),
        0 2px 0 #180904;
    }

    .header-btn.exit-btn:hover {
      background: linear-gradient(180deg, #6d2c1f 0%, #421a11 100%);
      color: #fff3b8;
    }

    .header-btn.exit-btn:active {
      box-shadow:
        inset 0 1px 0 rgba(255, 180, 140, 0.2),
        0 1px 0 #180904;
    }

    /* Compact Audio Toggle Icon Button */
    .header-btn.icon-btn,
    .pixel-icon-btn,
    #btnAudioToggle {
      width: 40px;
      min-width: 40px;
      height: 40px;
      min-height: 40px;
      padding: 0;
      background: linear-gradient(180deg, #fae078 0%, #e8be48 100%);
      border: 2.5px solid #7d3f0a;
      border-radius: 10px;
      color: #3b1a08;
      box-shadow:
        inset 0 2px 0 #fff7cb,
        inset 0 -2px 0 #b87820,
        0 2px 0 #2b1104;
    }

    #btnAudioToggle:hover {
      background: linear-gradient(180deg, #fff09e 0%, #fae078 100%);
    }

    #btnAudioToggle:active {
      box-shadow:
        inset 0 1px 0 #fff7cb,
        0 1px 0 #2b1104;
    }

    .header-btn.icon-btn.muted,
    .pixel-icon-btn.muted,
    #btnAudioToggle.muted {
      background: linear-gradient(180deg, #d4be9c 0%, #b89f78 100%);
      border-color: #6d4e32;
      opacity: 0.85;
      box-shadow:
        inset 0 2px 0 #ebe0d0,
        0 2px 0 #2b1104;
    }

    /* Timer directly positioned ON the burning fuse (No background panel/box/border) */
    .hud-timer-badge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      height: auto !important;
      width: auto !important;
      pointer-events: none;
      z-index: 5;
      white-space: nowrap;
    }

    .hud-q-timer {
      font-family: 'Press Start 2P', monospace;
      font-size: clamp(0.68rem, 2.3vw, 0.78rem);
      color: #ffffff;
      letter-spacing: 0.8px;
      white-space: nowrap;
      text-shadow:
        -1.5px -1.5px 0 #180904,
         1.5px -1.5px 0 #180904,
        -1.5px  1.5px 0 #180904,
         1.5px  1.5px 0 #180904,
        -1.5px  0     0 #180904,
         1.5px  0     0 #180904,
         0     -1.5px 0 #180904,
         0      1.5px 0 #180904,
         0      2px 2px rgba(0, 0, 0, 0.9);
      transition: color 0.15s ease, text-shadow 0.15s ease;
    }

    /* Urgent timer state (<= 3.0 seconds remaining) - Pulsing text outline, zero background */
    .hud-timer-badge.urgent {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      animation: pulseTimerText 0.38s infinite alternate ease-in-out;
    }

    .hud-timer-badge.urgent .hud-q-timer,
    .hud-q-timer.urgent {
      color: #ffe082;
      text-shadow:
        -1.5px -1.5px 0 #6a0404,
         1.5px -1.5px 0 #6a0404,
        -1.5px  1.5px 0 #6a0404,
         1.5px  1.5px 0 #6a0404,
        -1.5px  0     0 #6a0404,
         1.5px  0     0 #6a0404,
         0     -1.5px 0 #6a0404,
         0      1.5px 0 #6a0404,
         0 0 6px #ff1744,
         0 2px 2px #000000;
    }

    @keyframes pulseTimerText {
      from { transform: translate(-50%, -50%) scale(1); }
      to { transform: translate(-50%, -50%) scale(1.08); }
    }

    /* =========================================================================
       MAIN PLAYABLE GAME AREA (LOWERED WITH INTENTIONAL BREATHING ROOM)
       ========================================================================= */
    .main-playable-area {
      position: relative;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
      margin-top: 10px;
      padding-bottom: 2px;
      min-height: 0;
    }

    /* GAME STATS ROW: Score Board + Student Username + Misses Indicator */
    .hud-stats-bar {
      position: relative;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px 4px 12px;
      gap: 8px;
      flex-shrink: 0;
      width: 100%;
    }

    /* Wooden Score Plaque with Red Poker/Bounty Chip */
    .wood-score-board {
      position: relative;
      display: flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(180deg, #8c4b1e 0%, #6d3712 55%, #55280b 100%);
      border: 2.5px solid #351605;
      border-radius: 9px;
      padding: 3px 12px 3px 8px;
      min-width: 104px;
      height: 38px;
      box-shadow:
        inset 0 2px 0 rgba(255, 210, 155, 0.35),
        inset 0 -2px 0 rgba(0, 0, 0, 0.35),
        0 2px 0 rgba(0, 0, 0, 0.2);
    }

    .bounty-chip {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      filter: drop-shadow(0 2px 0 #2b1104);
    }

    .score-value {
      font-family: 'Press Start 2P', monospace;
      font-size: 1.1rem;
      color: #ffffff;
      text-shadow:
        2px 2px 0 #2b1104,
        -1px -1px 0 #2b1104,
        1px -1px 0 #2b1104,
        -1px 1px 0 #2b1104;
      letter-spacing: 1px;
    }

    /* Student Username Pill */
    .hud-username {
      font-size: 0.72rem;
      font-weight: 800;
      color: #6b3a18;
      background: rgba(238, 130, 26, 0.16);
      border: 1.5px solid rgba(197, 98, 18, 0.45);
      padding: 3px 10px;
      border-radius: 999px;
      max-width: 120px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-align: center;
      letter-spacing: 0.4px;
    }

    /* Missed-Tries HUD Indicator */
    .hud-misses-badge {
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(183, 28, 28, 0.12);
      border: 2px solid #b71c1c;
      border-radius: 9px;
      padding: 0 10px;
      font-family: 'Chakra Petch', sans-serif;
      height: 38px;
      box-sizing: border-box;
    }

    .hud-misses-badge .misses-label {
      font-size: 0.72rem;
      font-weight: 800;
      color: #851e1e;
      letter-spacing: 0.5px;
    }

    .hud-misses-badge .misses-val {
      font-size: 0.9rem;
      font-weight: 800;
      color: #b71c1c;
      letter-spacing: 0.5px;
    }

    @media (max-width: 360px) {
      .top-hud {
        padding: 8px 10px 4px 10px;
        gap: 6px;
      }
      .hud-timer-badge {
        padding: 0 !important;
      }
      .hud-q-timer {
        font-size: 0.65rem;
      }
      .hud-stats-bar {
        padding: 0 8px 4px 8px;
        gap: 4px;
      }
      .wood-score-board {
        min-width: 90px;
        padding: 3px 8px 3px 6px;
      }
      .score-value {
        font-size: 0.95rem;
      }
      .hud-misses-badge {
        padding: 0 6px;
      }
    }

    /* Duel Arena Illustration Area */
    .duel-stage-wrapper {
      position: relative;
      width: 100%;
      padding: 0 10px;
      flex-shrink: 0;
    }

    .duel-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 7.8;
      max-height: clamp(120px, 18vh, 175px);
      border-radius: 12px;
      overflow: hidden;
    }

    .duel-svg {
      width: 100%;
      height: 100%;
      display: block;
      image-rendering: pixelated;
    }

    /* Cowboy Animation States */
    .cowboy-player,
    .cowboy-enemy {
      transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
      transform-origin: center bottom;
    }

    .duel-stage.state-idle .cowboy-player,
    .duel-stage.state-idle .cowboy-enemy {
      animation: cowboyBreathe 1.4s ease-in-out infinite alternate;
    }

    .duel-stage.state-urgent .cowboy-enemy {
      animation: cowboyTwitch 0.25s ease-in-out infinite alternate;
    }

    @keyframes cowboyBreathe {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-2px); }
    }

    @keyframes cowboyTwitch {
      0% { transform: translateX(0px) rotate(0deg); }
      100% { transform: translateX(-2px) rotate(-1.5deg); }
    }

    /* Visibility of pose layers */
    .pose-hit,
    .muzzle-flash,
    .flying-gun,
    .shock-marks {
      opacity: 0;
      pointer-events: none;
    }

    /* Player shoots Enemy (Correct Answer) */
    .duel-stage.state-player-win .enemy-pose-idle {
      opacity: 0;
    }
    .duel-stage.state-player-win .enemy-pose-hit,
    .duel-stage.state-player-win .player-muzzle,
    .duel-stage.state-player-win .enemy-flying-gun,
    .duel-stage.state-player-win .enemy-shock {
      opacity: 1;
    }
    .duel-stage.state-player-win .enemy-pose-hit {
      animation: knockbackRight 0.45s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }
    .duel-stage.state-player-win .enemy-flying-gun {
      animation: gunSpinLeft 0.5s ease-out forwards;
    }

    /* Enemy shoots Player (Wrong Answer or Timeout) */
    .duel-stage.state-enemy-win .player-pose-idle {
      opacity: 0;
    }
    .duel-stage.state-enemy-win .player-pose-hit,
    .duel-stage.state-enemy-win .enemy-muzzle,
    .duel-stage.state-enemy-win .player-flying-gun,
    .duel-stage.state-enemy-win .player-shock {
      opacity: 1;
    }
    .duel-stage.state-enemy-win .player-pose-hit {
      animation: knockbackLeft 0.45s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }
    .duel-stage.state-enemy-win .player-flying-gun {
      animation: gunSpinRight 0.5s ease-out forwards;
    }

    @keyframes knockbackRight {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(12px, -10px) rotate(14deg); }
    }

    @keyframes knockbackLeft {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(-12px, -10px) rotate(-14deg); }
    }

    @keyframes gunSpinLeft {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(-18px, -16px) rotate(-38deg); }
    }

    @keyframes gunSpinRight {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(18px, -16px) rotate(38deg); }
    }

    /* Burning Fuse Timer Bar (Moved slightly downward beneath cowboy duel stage) */
    .fuse-bar-container {
      position: relative;
      width: 86%;
      margin: 10px auto 8px auto;
      height: 26px;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .fuse-track {
      position: relative;
      width: 100%;
      height: 16px;
      background: repeating-linear-gradient(
        90deg,
        #3d1c0a 0px,
        #3d1c0a 6px,
        #522710 6px,
        #522710 12px
      );
      border: 3px solid #2b1104;
      border-radius: 9px;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.75), 0 1px 0 #f7d794;
      overflow: hidden;
    }

    .fuse-fill {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 100%;
      background: repeating-linear-gradient(
        90deg,
        #ff9914 0px,
        #ffd042 6px,
        #e04f00 12px
      );
      border-radius: 6px;
      transition: background 0.2s ease;
    }

    .fuse-fill.urgent {
      background: repeating-linear-gradient(
        90deg,
        #ff2a00 0px,
        #ffae00 6px,
        #b80000 12px
      );
    }

    /* Tied Fuse End Knot on Right */
    .fuse-knot {
      width: 18px;
      height: 16px;
      margin-left: -2px;
      flex-shrink: 0;
    }

    /* Burning Spark on the Moving Fuse Tip */
    .fuse-spark {
      position: absolute;
      top: 50%;
      left: 100%;
      width: 34px;
      height: 34px;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 4;
      animation: sparkFlicker 0.12s infinite alternate;
    }

    @keyframes sparkFlicker {
      0% { transform: translate(-50%, -50%) scale(0.92) rotate(-8deg); }
      100% { transform: translate(-50%, -50%) scale(1.12) rotate(8deg); }
    }

    /* Sky-Blue Pixel Vocabulary Card */
    .word-card-wrap {
      padding: 2px 16px;
      flex-shrink: 0;
    }

    .word-card {
      position: relative;
      background: var(--word-blue-bg);
      border: 4px solid var(--word-blue-border);
      border-radius: 16px;
      padding: 14px 14px 12px 14px;
      text-align: center;
      box-shadow:
        inset 0 4px 0 var(--word-blue-highlight),
        inset 0 -4px 0 #79b4f2,
        0 4px 0 rgba(14, 99, 198, 0.22);
      min-height: 98px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    /* Corner Pixel Accents */
    .word-card::before,
    .word-card::after {
      content: "";
      position: absolute;
      width: 12px;
      height: 12px;
      border-color: #5ca2eb;
      border-style: solid;
      pointer-events: none;
    }
    .word-card::before {
      top: 7px;
      left: 7px;
      border-width: 3px 0 0 3px;
    }
    .word-card::after {
      bottom: 7px;
      right: 7px;
      border-width: 0 3px 3px 0;
    }

    .target-word {
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 800;
      font-size: clamp(1.6rem, 6.5vw, 2.25rem);
      color: var(--word-navy-text);
      line-height: 1.1;
      letter-spacing: 0.5px;
      word-break: break-word;
      text-shadow: 0 2px 0 rgba(255, 255, 255, 0.45);
    }

    .target-word-container {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      max-width: 100%;
      cursor: pointer;
    }

    .word-speaker-btn {
      width: 34px;
      height: 34px;
      min-width: 34px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.7);
      border: 2px solid var(--word-blue-border);
      color: var(--word-navy-text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.1s ease, background 0.15s ease;
      flex-shrink: 0;
      touch-action: manipulation;
    }

    .word-speaker-btn:hover {
      background: #ffffff;
      transform: scale(1.08);
    }

    .word-speaker-btn:active {
      transform: scale(0.92);
    }

    .word-speaker-btn.speaking {
      animation: speaker-pulse 0.8s ease-in-out infinite;
      color: #0e63c6;
    }

    @keyframes speaker-pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }

    /* Fast touch response without double tap zoom delays */
    .answer-btn,
    .header-btn,
    .western-btn,
    .word-speaker-btn {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    .target-meaning {
      margin-top: 5px;
      font-size: clamp(0.95rem, 3.8vw, 1.18rem);
      font-weight: 700;
      color: var(--meaning-blue-text);
      line-height: 1.25;
    }

    /* 2x2 Answer Options Grid */
    .answers-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px 12px;
      padding: 4px 14px 6px 14px;
      align-content: center;
      z-index: 5;
    }

    @media (max-width: 335px) {
      .answers-grid {
        grid-template-columns: 1fr;
        gap: 6px;
      }
    }

    /* Category 2: Gameplay Answer / Shooting Controls */
    .answer-btn {
      position: relative;
      height: clamp(48px, 6.2vh, 64px);
      min-height: clamp(48px, 6.2vh, 64px);
      width: 100%;
      padding: 6px 10px;
      background: var(--btn-gold-bg);
      border: 3.5px solid var(--btn-gold-border);
      border-radius: 12px;
      box-shadow:
        inset 0 3px 0 var(--btn-gold-highlight),
        inset 0 -3px 0 #e6be4c,
        0 4px 0 var(--btn-gold-shadow);
      font-family: 'Chakra Petch', sans-serif;
      font-size: clamp(0.95rem, 3.8vw, 1.22rem);
      font-weight: 800;
      letter-spacing: 0.4px;
      line-height: 1.15;
      color: var(--btn-text-dark);
      text-align: center;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      word-break: break-word;
      overflow: hidden;
      text-overflow: ellipsis;
      user-select: none;
      box-sizing: border-box;
      transition: transform 0.08s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .answer-btn:hover:not(:disabled) {
      background: #ffea8c;
    }

    .answer-btn:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow:
        inset 0 2px 0 var(--btn-gold-highlight),
        0 1px 0 var(--btn-gold-shadow);
    }

    .answer-btn:disabled {
      cursor: default;
    }

    .answer-btn.correct {
      background: #81c784 !important;
      border-color: #1b5e20 !important;
      color: #0d3311 !important;
      box-shadow:
        inset 0 4px 0 #b9f6ca,
        0 4px 0 #1b5e20 !important;
    }

    .answer-btn.wrong {
      background: #ef9a9a !important;
      border-color: #b71c1c !important;
      color: #5f0909 !important;
      box-shadow:
        inset 0 4px 0 #ffcdd2,
        0 4px 0 #7f0000 !important;
    }

    /* Bottom Desert Horizon Banner */
    .desert-footer {
      width: 100%;
      height: clamp(34px, 5.5vh, 60px);
      flex-shrink: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .desert-footer svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Overlay Screens (Title / Username / Loading / Error / Game Over / Victory) */
    .overlay-screen {
      position: absolute;
      inset: 0;
      z-index: 20;
      background: rgba(248, 237, 214, 0.97);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 18px 18px 14px 18px;
      text-align: center;
      overflow-y: auto;
    }

    .overlay-screen.hidden {
      display: none !important;
    }

    .wanted-poster {
      width: 100%;
      background: #f3dfb9;
      border: 4px solid #7d4218;
      border-radius: 16px;
      padding: 16px 14px;
      box-shadow:
        inset 0 0 0 2px #d9b882,
        0 6px 0 rgba(79, 39, 17, 0.22);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin: auto 0;
    }

    .game-logo-badge {
      background: linear-gradient(180deg, #8c4b1e 0%, #55280b 100%);
      border: 3px solid #2b1104;
      border-radius: 12px;
      padding: 10px 16px;
      color: #ffd56b;
      font-family: 'Press Start 2P', monospace;
      font-size: clamp(1.05rem, 4.5vw, 1.35rem);
      text-shadow: 2px 2px 0 #2b1104;
      letter-spacing: 1px;
      box-shadow: 0 4px 0 #2b1104;
    }

    /* ==================== 25-POINT SHARPSHOOTER CELEBRATION STYLES ==================== */
    .celebration-overlay {
      z-index: 35 !important;
      background: radial-gradient(circle at center, rgba(62, 30, 14, 0.96) 0%, rgba(27, 12, 5, 0.98) 100%) !important;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      padding: 16px 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .celebration-poster {
      background: radial-gradient(circle at 50% 30%, #fff9ec 0%, #f7e6c4 55%, #edd2a1 100%) !important;
      border: 4px solid #7d4218 !important;
      border-radius: 18px !important;
      padding: 20px 16px 16px !important;
      box-shadow:
        inset 0 0 0 3px #d9b882,
        inset 0 0 20px rgba(184, 120, 32, 0.25),
        0 10px 30px rgba(0, 0, 0, 0.55),
        0 0 25px rgba(255, 179, 0, 0.35) !important;
      max-width: 380px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      animation: celebrationCardPop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes celebrationCardPop {
      0% {
        opacity: 0;
        transform: scale(0.82) translateY(18px);
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    .celebration-badge-container {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .celebration-title-badge {
      background: linear-gradient(180deg, #b35900 0%, #733000 50%, #4a1d00 100%) !important;
      border: 3px solid #2b1104 !important;
      border-radius: 12px !important;
      padding: 10px 18px !important;
      color: #ffe066 !important;
      font-family: 'Press Start 2P', monospace !important;
      font-size: clamp(1.05rem, 4.8vw, 1.35rem) !important;
      text-shadow: 2px 2px 0 #2b1104, 0 0 10px rgba(255, 204, 0, 0.6) !important;
      letter-spacing: 1.5px !important;
      box-shadow: 0 4px 0 #2b1104, 0 0 16px rgba(255, 170, 0, 0.4) !important;
      white-space: nowrap;
    }

    .celebration-trophy {
      width: 86px;
      height: 86px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 2px 0;
      filter: drop-shadow(0 4px 10px rgba(74, 34, 13, 0.35));
      animation: trophyGleam 2.2s ease-in-out infinite alternate;
    }

    .celebration-star-svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    @keyframes trophyGleam {
      0% {
        transform: scale(1) rotate(0deg);
        filter: drop-shadow(0 4px 8px rgba(74, 34, 13, 0.35));
      }
      100% {
        transform: scale(1.05) rotate(2deg);
        filter: drop-shadow(0 6px 14px rgba(255, 170, 0, 0.55));
      }
    }

    .celebration-message {
      font-family: 'Chakra Petch', sans-serif;
      font-size: clamp(0.92rem, 3.8vw, 1.08rem);
      font-weight: 800;
      color: #4a220d;
      line-height: 1.35;
      text-align: center;
      text-transform: none;
      letter-spacing: 0.3px;
      margin: 0;
      padding: 0 4px;
    }

    .celebration-milestone-plaque {
      width: 100%;
      background: rgba(125, 66, 24, 0.12);
      border: 2px dashed #8c4b1e;
      border-radius: 10px;
      padding: 8px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .celebration-plaque-label {
      font-family: 'Press Start 2P', monospace;
      font-size: 0.62rem;
      font-weight: 700;
      color: #7d4218;
      letter-spacing: 1px;
    }

    .celebration-plaque-score {
      font-family: 'Press Start 2P', monospace;
      font-size: 1.25rem;
      color: #993d00;
      display: flex;
      align-items: baseline;
      gap: 6px;
      text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.6);
    }

    .celebration-plaque-pts {
      font-family: 'Chakra Petch', sans-serif;
      font-size: 0.78rem;
      font-weight: 800;
      color: #6d3712;
      letter-spacing: 0.5px;
    }

    .celebration-actions {
      width: 100%;
      margin-top: 4px;
      display: flex;
      justify-content: center;
    }

    .celebration-btn {
      width: 100%;
      max-width: 260px;
      min-height: 48px;
      font-size: 0.98rem !important;
      letter-spacing: 0.8px;
      box-shadow:
        inset 0 3px 0 #ffe082,
        0 4px 0 #4f2711,
        0 0 12px rgba(255, 170, 0, 0.35) !important;
    }

    .celebration-btn:active {
      transform: translateY(2px) !important;
      box-shadow:
        inset 0 2px 0 #ffe082,
        0 2px 0 #4f2711 !important;
    }

    .subtitle-banner {
      font-size: 0.85rem;
      font-weight: 800;
      color: #6d3712;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .field-group {
      width: 100%;
      text-align: left;
      margin-top: 4px;
    }

    .field-label {
      display: block;
      font-size: 0.78rem;
      font-weight: 800;
      color: #5b2c0e;
      margin-bottom: 4px;
      text-transform: uppercase;
    }

    .western-input {
      width: 100%;
      padding: 11px 12px;
      font-family: 'Chakra Petch', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: #2b1104;
      background: #fff9eb;
      border: 3px solid #8c4b1e;
      border-radius: 10px;
      outline: none;
      user-select: text;
      -webkit-user-select: text;
    }

    .western-input:focus {
      border-color: var(--word-blue-border);
      box-shadow: 0 0 0 3px rgba(14, 99, 198, 0.2);
    }

    .status-box {
      width: 100%;
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      line-height: 1.35;
      background: #e9d2a6;
      border: 2px solid #9e6b3b;
      color: #4a250d;
    }

    .status-box.error {
      background: #ffebee;
      border-color: #c62828;
      color: #8e0000;
    }

    .status-box.success {
      background: #e8f5e9;
      border-color: #2e7d32;
      color: #1b5e20;
    }

    .security-note {
      font-size: 0.72rem;
      color: #6e4726;
      line-height: 1.3;
      background: rgba(140, 75, 30, 0.1);
      padding: 7px 9px;
      border-radius: 8px;
      border: 1px dashed #8c4b1e;
    }

    /* Category 3: Dialog & Screen Action Buttons (Western Action Buttons) */
    .btn-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      margin-top: 8px;
    }

    .btn-row > .western-btn {
      flex: 1 1 calc(50% - 10px);
      min-width: 130px;
      max-width: 240px;
    }

    @media (max-width: 360px) {
      .btn-row > .western-btn {
        flex: 1 1 100%;
        max-width: 100%;
      }
    }

    .western-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      height: 48px;
      min-width: 130px;
      padding: 10px 18px;
      box-sizing: border-box;
      font-family: 'Chakra Petch', sans-serif;
      font-size: 0.95rem;
      font-weight: 800;
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      text-align: center;
      text-decoration: none;
      color: #2b1104;
      background: var(--btn-gold-bg);
      border: 3px solid #6d3712;
      border-radius: 10px;
      box-shadow:
        inset 0 3px 0 var(--btn-gold-highlight),
        0 4px 0 #4f2711;
      cursor: pointer;
      user-select: none;
      transition: transform 0.08s ease, opacity 0.15s ease, background-color 0.15s ease, filter 0.15s ease;
    }

    .western-btn.primary {
      background: #ff9800;
      border-color: #6d3712;
      color: #2b1104;
      box-shadow:
        inset 0 3px 0 #ffe082,
        0 4px 0 #4f2711;
    }

    .western-btn.primary:hover:not(:disabled) {
      background: #ffa726;
    }

    .western-btn.secondary {
      background: #e6ccb2;
      border-color: #6d3712;
      color: #2b1104;
      box-shadow:
        inset 0 3px 0 #fff3e0,
        0 4px 0 #4f2711;
    }

    .western-btn.secondary:hover:not(:disabled) {
      background: #edd8c4;
    }

    .western-btn:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #4f2711;
    }

    .western-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .western-btn.main-cta {
      animation: pulse-cta 2.2s infinite ease-in-out;
    }
    @keyframes pulse-cta {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); box-shadow: inset 0 3px 0 #ffe082, 0 6px 14px rgba(255, 152, 0, 0.45); }
    }
    .quick-chip {
      background: #fdf5e6;
      border: 1.5px solid #8c4b1e;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 0.75rem;
      font-weight: 700;
      color: #5b2c0e;
      cursor: pointer;
      transition: all 0.12s ease;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      user-select: none;
    }
    .quick-chip:hover {
      background: #ffecb3;
      transform: translateY(-1px);
    }
    .quick-chip.active {
      background: #ff9800;
      color: #2b1104;
      border-color: #6d3712;
      box-shadow: inset 0 1px 0 #ffe082;
    }
    .deck-badge {
      font-size: 0.7rem;
      background: #6d3712;
      color: #fff;
      padding: 2px 8px;
      border-radius: 6px;
      font-weight: 700;
    }

    /* Stats Grid on Game Over / Victory */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      width: 100%;
      margin: 4px 0;
    }

    .stat-tile {
      background: #fff6e0;
      border: 2px solid #9e5824;
      border-radius: 10px;
      padding: 8px 6px;
    }

    .stat-label {
      font-size: 0.7rem;
      font-weight: 800;
      color: #7d4218;
      text-transform: uppercase;
    }

    .stat-num {
      font-family: 'Press Start 2P', monospace;
      font-size: 1rem;
      color: #2b1104;
      margin-top: 5px;
    }

    /* Loading Spinner */
    .revolver-spinner {
      display: inline-block;
      width: 28px;
      height: 28px;
      border: 4px solid #c56212;
      border-top-color: transparent;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
      margin-bottom: 4px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Round Feedback Toast Banner */
    .feedback-banner {
      position: absolute;
      top: 58px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 15;
      padding: 6px 14px;
      border-radius: 999px;
      font-family: 'Press Start 2P', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.5px;
      border: 3px solid #2b1104;
      box-shadow: 0 4px 0 rgba(0,0,0,0.25);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    .feedback-banner.show {
      opacity: 1;
    }

    .feedback-banner.hit {
      background: #81c784;
      color: #0d3311;
    }

    .feedback-banner.miss {
      background: #ef5350;
      color: #ffffff;
    }
  </style>
</head>
