    function normalizeText(str) {
      return typeof str === "string" ? str.trim() : "";
    }

    function normalizeKey(str) {
      return normalizeText(str).toLowerCase();
    }

    function isEligibleMasteredWord(rawDoc, expectedUsername) {
      if (!rawDoc || typeof rawDoc !== "object") return null;

      // 1. Username match (case-insensitive & trimmed)
      const docUsername = normalizeText(rawDoc.username);
      if (expectedUsername && docUsername && normalizeKey(docUsername) !== normalizeKey(expectedUsername)) {
        return null;
      }

      // 2. Valid English word
      const word = normalizeText(rawDoc.word);
      if (!word) return null;

      // 3. Valid Vietnamese meaning hint
      const meaning = normalizeText(rawDoc.meaning || rawDoc.translation);
      if (!meaning) return null;

      // 4. Usable synonyms
      const syn1 = normalizeText(rawDoc.synonym1 || rawDoc.synonym);
      const syn2 = normalizeText(rawDoc.synonym2);
      const validSynonyms = [];

      if (syn1 && normalizeKey(syn1) !== normalizeKey(word)) {
        validSynonyms.push(syn1);
      }
      if (
        syn2 &&
        normalizeKey(syn2) !== normalizeKey(word) &&
        normalizeKey(syn2) !== normalizeKey(syn1)
      ) {
        validSynonyms.push(syn2);
      }

      if (Array.isArray(rawDoc.synonyms)) {
        for (const s of rawDoc.synonyms) {
          const sText = normalizeText(s);
          if (sText && normalizeKey(sText) !== normalizeKey(word) && !validSynonyms.some(v => normalizeKey(v) === normalizeKey(sText))) {
            validSynonyms.push(sText);
          }
        }
      }

      if (validSynonyms.length === 0) return null;

      return {
        word,
        meaning,
        synonyms: validSynonyms,
        memoryStatus: rawDoc.memoryStatus || "unknown",
        topic: (rawDoc.topic || "").trim()
      };
    }

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    /**
     * Dynamically builds 4-option multiple choice questions.
     * If the pool of synonyms is small (< 3 distractors), candidate distractors
     * are seamlessly drawn from DEFAULT_DUEL_DECK so every single word is playable.
     */
    function buildQuestionBank(eligibleWords) {
      if (!eligibleWords || eligibleWords.length === 0) {
        eligibleWords = DEFAULT_DUEL_DECK;
      }

      const wordMap = new Map();

      for (const item of eligibleWords) {
        const key = normalizeKey(item.word);
        if (!wordMap.has(key)) {
          wordMap.set(key, {
            word: item.word,
            meaning: item.meaning,
            synonyms: [...item.synonyms],
            forbiddenKeys: new Set([
              key,
              ...item.synonyms.map(normalizeKey)
            ])
          });
        } else {
          const existing = wordMap.get(key);
          for (const syn of item.synonyms) {
            const synKey = normalizeKey(syn);
            if (!existing.forbiddenKeys.has(synKey)) {
              existing.synonyms.push(syn);
              existing.forbiddenKeys.add(synKey);
            }
          }
        }
      }

      const uniqueEntries = Array.from(wordMap.values());

      // Collect all candidate distractor synonyms across pool
      const allPoolSynonyms = [];
      for (const entry of uniqueEntries) {
        for (const syn of entry.synonyms) {
          allPoolSynonyms.push({
            text: syn,
            key: normalizeKey(syn),
            sourceWordKey: normalizeKey(entry.word)
          });
        }
      }

      const questions = [];

      for (const entry of uniqueEntries) {
        const chosenCorrect =
          entry.synonyms[Math.floor(Math.random() * entry.synonyms.length)];
        const chosenCorrectKey = normalizeKey(chosenCorrect);

        const distractorCandidates = [];
        const seenKeys = new Set(entry.forbiddenKeys);
        seenKeys.add(chosenCorrectKey);

        // 1. Try pool distractors first
        for (const candidate of shuffleArray(allPoolSynonyms)) {
          if (candidate.sourceWordKey === normalizeKey(entry.word)) continue;
          if (seenKeys.has(candidate.key)) continue;
          seenKeys.add(candidate.key);
          distractorCandidates.push(candidate.text);
          if (distractorCandidates.length === 3) break;
        }

        // 2. If fewer than 3 distractors, supplement from DEFAULT_DUEL_DECK
        if (distractorCandidates.length < 3) {
          for (const fallbackItem of shuffleArray(DEFAULT_DUEL_DECK)) {
            for (const syn of fallbackItem.synonyms) {
              const synKey = normalizeKey(syn);
              if (!seenKeys.has(synKey) && synKey !== normalizeKey(entry.word)) {
                seenKeys.add(synKey);
                distractorCandidates.push(syn);
                if (distractorCandidates.length === 3) break;
              }
            }
            if (distractorCandidates.length === 3) break;
          }
        }

        if (distractorCandidates.length === 3) {
          const options = shuffleArray([chosenCorrect, ...distractorCandidates]);
          questions.push({
            word: entry.word,
            meaning: entry.meaning,
            correctAnswer: chosenCorrect,
            options
          });
        }
      }

      return shuffleArray(questions);
    }

    async function tryLoadFromIndexedDB(expectedUser) {
      return new Promise((resolve) => {
        try {
          if (!window.indexedDB) return resolve({ words: [], masteredCount: 0, allUsers: [] });
          const req = indexedDB.open("LexicalSpaceDB", 1);
          req.onerror = () => resolve({ words: [], masteredCount: 0, allUsers: [] });
          req.onsuccess = (e) => {
            const db = e.target.result;
            if (!db.objectStoreNames.contains("words")) return resolve({ words: [], masteredCount: 0, allUsers: [] });
            const tx = db.transaction("words", "readonly");
            const store = tx.objectStore("words");
            const getReq = store.getAll();
            getReq.onerror = () => resolve({ words: [], masteredCount: 0, allUsers: [] });
            getReq.onsuccess = () => {
              const all = getReq.result || [];
              const u = expectedUser ? normalizeKey(expectedUser) : "";
              const matchedMastered = [];
              const matchedAny = [];
              const userSet = new Set();

              for (const item of all) {
                if (item && item.username) {
                  const uname = normalizeText(item.username);
                  if (uname) userSet.add(uname);
                }

                if (!u) continue;
                const itemUser = normalizeKey(item.username || "");
                if (itemUser === u) {
                  const validated = isEligibleMasteredWord(item, expectedUser);
                  if (validated) {
                    if (item.memoryStatus === "mastered") {
                      matchedMastered.push(validated);
                    }
                    matchedAny.push(validated);
                  }
                }
              }

              const chosen = matchedMastered.length >= 4 ? matchedMastered : (matchedAny.length > 0 ? matchedAny : []);
              resolve({
                words: chosen,
                masteredCount: matchedMastered.length,
                allUsers: Array.from(userSet)
              });
            };
          };
        } catch (_) {
          resolve({ words: [], masteredCount: 0, allUsers: [] });
        }
      });
    }

    async function loadStudentVocabulary(isSilent = false) {
      if (!isSilent) sound.playClick();
      const username = normalizeText(dom.usernameInput.value);

      if (!username) {
        // Quick Play / Guest Mode
        state.activeUsername = "Guest Cowboy";
        state.eligibleWords = [...DEFAULT_DUEL_DECK];
        state.questionBank = buildQuestionBank(state.eligibleWords);
        dom.hudUsername.textContent = "Guest Cowboy";
        if (dom.deckBadge) dom.deckBadge.textContent = "Starter Deck (24 words)";
        setVocabStatus("⚡ Quick Play active: Using Western Starter Deck (24 academic words). Ready to duel!", "success");
        dom.btnStartGame.disabled = false;
        const users = await discoverLocalUsers();
        renderQuickUserChips(users);
        return;
      }

      if (!isSilent) {
        dom.vocabStatusBox.className = "status-box";
        dom.vocabStatusBox.innerHTML = `<div class="revolver-spinner"></div><div>Loading vocabulary for <strong>${escapeHtml(username)}</strong>...</div>`;
        dom.btnLoadVocab.disabled = true;
      }

      try {
        // 1. Check local IndexedDB first
        const localResult = await tryLoadFromIndexedDB(username);
        let words = localResult.words || [];
        let loadedFromLocal = words.length >= 4;

        // 2. If fewer than 4 in local DB and online, query Firestore
        if (words.length < 4 && navigator.onLine) {
          const fbStatus = ensureFirebaseInitialized();
          if (fbStatus.ok) {
            try {
              let snapshot = await state.db
                .collection(LEXICALSPACE_CONFIG.wordsCollection)
                .where("username", "==", username)
                .where("memoryStatus", "==", "mastered")
                .get();

              let cloudEligible = [];
              snapshot.forEach((docSnap) => {
                const validated = isEligibleMasteredWord(docSnap.data(), username);
                if (validated) cloudEligible.push(validated);
              });

              if (cloudEligible.length < 4) {
                snapshot = await state.db
                  .collection(LEXICALSPACE_CONFIG.wordsCollection)
                  .where("username", "==", username)
                  .get();

                cloudEligible = [];
                snapshot.forEach((docSnap) => {
                  const validated = isEligibleMasteredWord(docSnap.data(), username);
                  if (validated) cloudEligible.push(validated);
                });
              }

              if (cloudEligible.length > 0) {
                words = cloudEligible;
                loadedFromLocal = false;
              }
            } catch (fsErr) {
              console.warn("Firestore query warning:", fsErr);
            }
          }
        }

        state.activeUsername = username;
        persistUsernameToStorage(username);
        dom.hudUsername.textContent = username;

        if (words.length >= 4) {
          state.eligibleWords = words;
          if (dom.deckBadge) dom.deckBadge.textContent = `${words.length} Student Words`;
          const src = loadedFromLocal ? " (Offline cache)" : " (Cloud Firestore)";
          setVocabStatus(
            `⭐ Loaded ${words.length} vocabulary words for "${username}"${src}! Ready to draw!`,
            "success"
          );
        } else if (words.length > 0) {
          state.eligibleWords = [...words, ...DEFAULT_DUEL_DECK];
          if (dom.deckBadge) dom.deckBadge.textContent = `Hybrid (${words.length} + Starter)`;
          setVocabStatus(
            `🤠 Found ${words.length} word(s) for "${username}"! Combined with Starter Deck for a full duel. Ready!`,
            "success"
          );
        } else {
          state.eligibleWords = [...DEFAULT_DUEL_DECK];
          if (dom.deckBadge) dom.deckBadge.textContent = "Starter Deck (24 words)";
          setVocabStatus(
            `🤠 No saved words found for "${username}". Using Western Starter Deck (24 words). Ready to duel!`,
            "success"
          );
        }

        state.questionBank = buildQuestionBank(state.eligibleWords);
        dom.btnStartGame.disabled = false;
        dom.btnLoadVocab.disabled = false;
        dom.btnLoadVocab.textContent = "⚡ Sync";

        renderQuickUserChips(localResult.allUsers || []);
      } catch (err) {
        state.eligibleWords = [...DEFAULT_DUEL_DECK];
        state.questionBank = buildQuestionBank(state.eligibleWords);
        dom.btnStartGame.disabled = false;
        dom.btnLoadVocab.disabled = false;
        dom.btnLoadVocab.textContent = "⚡ Sync";
        setVocabStatus(`Could not reach cloud: ${err.message || "Offline"}. Western Starter Deck is ready to duel!`, "success");
      }
    }

