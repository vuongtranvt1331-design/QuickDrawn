    }

    function getEffectiveUsernameStorageKey() {
      return LEXICALSPACE_CONFIG.usernameStorageKey || "username";
    }

    function ensureFirebaseInitialized() {
      const config = getEffectiveFirebaseConfig();
      if (!config) {
        return { ok: false, reason: "missing_config" };
      }
      try {
        if (!firebase.apps.length) {
          firebase.initializeApp(config);
        }
        state.db = firebase.firestore();
        return { ok: true };
      } catch (err) {
        return { ok: false, reason: err.message || "Failed to initialize Firebase." };
      }
    }

    function detectStoredUsername() {
      // Check the primary LexicalSpace localStorage key and fallback keys
      const keysToCheck = [
        getEffectiveUsernameStorageKey(),
        ...LEXICALSPACE_CONFIG.fallbackUsernameKeys
      ];

      for (const key of keysToCheck) {
        try {
          const raw = localStorage.getItem(key);
          if (!raw) continue;
          const trimmed = raw.trim();
          if (!trimmed) continue;
          // Handle JSON object if LexicalSpace stored a user object
          if (trimmed.startsWith("{")) {
            const parsed = JSON.parse(trimmed);
            if (parsed && typeof parsed.username === "string" && parsed.username.trim()) {
              return parsed.username.trim();
            }
          } else {
            return trimmed;
          }
        } catch (_) {}
      }
      return "";
    }

    function persistUsernameToStorage(username) {
      const key = getEffectiveUsernameStorageKey();
      try {
        localStorage.setItem(key, username);
      } catch (_) {}
    }

    function getBestScore(username) {
      if (!username) return 0;
      try {
        const val = parseInt(localStorage.getItem(LOCAL_KEYS.BEST_SCORE_PREFIX + username.toLowerCase()), 10);
        return Number.isFinite(val) && val > 0 ? val : 0;
      } catch (_) {
        return 0;
      }
    }

    function saveBestScore(username, score) {
      if (!username) return 0;
      const currentBest = getBestScore(username);
      const nextBest = Math.max(currentBest, score);
      try {
        localStorage.setItem(LOCAL_KEYS.BEST_SCORE_PREFIX + username.toLowerCase(), String(nextBest));
      } catch (_) {}
      return nextBest;
    }

